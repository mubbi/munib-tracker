diff --git a/ios/OnnxruntimeModule.mm b/ios/OnnxruntimeModule.mm
index 8155f92aa4770c2c13c6c7c3db2a38f7311282c1..682059da52f3ff33a4a5c3dc35a36abe0da64915 100644
--- a/ios/OnnxruntimeModule.mm
+++ b/ios/OnnxruntimeModule.mm
@@ -9,6 +9,11 @@
 #import <React/RCTUtils.h>
 #import <ReactCommon/RCTTurboModule.h>
 #import <jsi/jsi.h>
+#import <objc/runtime.h>
+
+@protocol OrtJsiRuntimeProvider <NSObject>
+- (void*)runtime;
+@end
 
 @implementation OnnxruntimeModule
 
@@ -27,12 +32,16 @@ RCT_EXPORT_MODULE(Onnxruntime)
  */
 RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(install) {
   @try {
-    RCTCxxBridge* cxxBridge = (RCTCxxBridge*)_bridge;
-    if (cxxBridge == nil) {
+    // RN 0.88 no longer declares RCTCxxBridge. Both the bridgeless
+    // RCTBridgeProxy and the legacy RCTCxxBridge implement `- (void *)runtime`,
+    // so resolve it dynamically instead of casting to a removed class.
+    id<OrtJsiRuntimeProvider> runtimeProvider = (id<OrtJsiRuntimeProvider>)_bridge;
+    if (runtimeProvider == nil ||
+        !class_respondsToSelector(object_getClass(runtimeProvider), @selector(runtime))) {
       return @false;
     }
 
-    auto jsiRuntime = (facebook::jsi::Runtime*)cxxBridge.runtime;
+    auto jsiRuntime = (facebook::jsi::Runtime*)[runtimeProvider runtime];
     if (jsiRuntime == nil) {
       return @false;
     }
diff --git a/onnxruntime-react-native.podspec b/onnxruntime-react-native.podspec
index 58bbbdac34948696bd2c3dc923c8ef1cfefe8e2c..d5df9af7312e30bee345bf65a6b18e39f7926221 100644
--- a/onnxruntime-react-native.podspec
+++ b/onnxruntime-react-native.podspec
@@ -23,7 +23,19 @@ Pod::Spec.new do |spec|
   spec.source_files         = "ios/*.{h,mm}", "cpp/*.{h,cpp}"
   spec.private_header_files = "ios/*.h", "cpp/*.h"
 
-  spec.dependency "onnxruntime-c"
+  # Pin the native runtime to this binding's version (Android pins the same AAR);
+  # unpinned, CocoaPods resolves whatever onnxruntime-c is newest at install time.
+  spec.dependency "onnxruntime-c", package["version"]
+
+  # The app also links TajweedFormer, whose static `zf_rt` shim exports its own
+  # global `OrtGetApiBase` (a minimal ORT C-API subset, API <= 28). The linker
+  # bound this binding to that shim → `GetApi()` returned NULL → SIGSEGV in
+  # `Ort::Env`. The Podfile post_install hook
+  # (apps/app/scripts/isolate-onnxruntime-symbol.cjs) renames the real runtime's
+  # entry point inside the onnxruntime-c archive; call it by that name here.
+  spec.pod_target_xcconfig = {
+    'GCC_PREPROCESSOR_DEFINITIONS' => '$(inherited) OrtGetApiBase=MunibOrtGetAB',
+  }
 
   if respond_to?(:install_modules_dependencies, true)
     install_modules_dependencies(spec)
