+private fun mapParams(map: Map<String, Any?>, key: String): Map<String, Any>? {
+    val nested = map[key] as? Map<*, *> ?: return null
+    val out = mutableMapOf<String, Any>()
+    nested.forEach { (nestedKey, value) ->
+        if (nestedKey is String && (value is String || value is Number || value is Boolean)) {
+            out[nestedKey] = value
+        }
+    }
+    return out.ifEmpty { null }
