+/**
+ * Parse a JS shortcut object without going through Expo Record conversion.
+ * `List<ActionObject>` NPEs on some Android devices when ReadableNativeMap
+ * cannot be reflected into ActionObject (`params` Map<String, Any>, optional
+ * nulls, R8-stripped constructors). ReadableMap is a trivial converter.
+ */
+private fun readableString(map: ReadableMap, key: String): String? {
+    if (!map.hasKey(key) || map.isNull(key)) return null
+    return if (map.getType(key) == ReadableType.String) map.getString(key) else null
+}
+
+private fun readableParams(map: ReadableMap, key: String): Map<String, Any>? {
+    if (!map.hasKey(key) || map.isNull(key)) return null
+    if (map.getType(key) != ReadableType.Map) return null
+    val nested = map.getMap(key) ?: return null
+    val out = mutableMapOf<String, Any>()
+    nested.toHashMap().forEach { (nestedKey, value) ->
+        when (value) {
+            is String, is Number, is Boolean -> out[nestedKey] = value
+        }
+    }
+    return out.ifEmpty { null }
+}
+
+private fun actionFromReadableMap(map: ReadableMap): ActionObject {
+    return ActionObject(
+        id = readableString(map, "id") ?: "",
+        title = readableString(map, "title") ?: "",
+        subtitle = readableString(map, "subtitle"),
+        icon = readableString(map, "icon"),
+        params = readableParams(map, "params")
+    )
+}
