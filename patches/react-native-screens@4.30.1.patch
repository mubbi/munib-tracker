+    // Building ImageRequestBuilder triggers Fresco Priority.<clinit>; doing that on the
+    // main thread ANRs low-RAM devices when NativeTabs set an image icon. Start the
+    // request off the main thread and deliver the result back on it.
+    val appContext = context.applicationContext
+    loadExecutor.execute {
+        try {
+            loadImageInternal(appContext, resolvedUri) { drawable ->
+                mainHandler.post { onComplete(drawable) }
+            }
+        } catch (error: Exception) {
+            Log.e(TAG, "[RNScreens] Error loading image: $resolvedUri", error)
+            mainHandler.post { onComplete(null) }
         }
     }
