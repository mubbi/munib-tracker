# Dependencies
node_modules/

# Turbo
.turbo/

# Build outputs
dist/
.next/
out/
web-build/
expo-env.d.ts

# Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Native (generated by Expo prebuild under apps/app only — do NOT ignore
# store-assets/ios or store-assets/captures/ios)
apps/app/android/
apps/app/ios/

# Local Expo module Gradle outputs (keep android/src; ignore build/)
apps/app/modules/**/android/build/

# Testing / coverage reports (generated — never commit)
coverage/
*.lcov

# Environment
.env
.env*.local
!.env.example
!**/.env.example

# Signing / store credentials (never commit)
**/*.keystore
**/google-services.json
**/GoogleService-Info.plist
apps/app/ios-keys/*.env
apps/app/ios-keys/ExportOptions.plist
apps/app/ios-keys/ExportOptions.tvos.plist
apps/app/ios-keys/**/*.cer
!apps/app/ios-keys/*.env.example
!apps/app/ios-keys/ExportOptions.plist.template
apps/app/ios-keys/tvos-signing/README.txt
!apps/app/ios-keys/tvos-signing/README.txt.example

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Misc
.vercel
.tmp/
.tmp-*/
.tmp-gaps-*.json
.tmp-admin-lint.json
.edge-tmp*/
report.xml
apps/app/android-keys/
apps/app/.screenshots-work/
packages/shared/scripts/.overlay-translate-cache/
packages/shared/scripts/.hi-*-cache.json
apps/app/scripts/i18n/.translation-cache/
apps/app/src/i18n/*-partial-*.json
apps/app/src/config/seo-routes-locale/.*extract.json

# Qur'an practice: downloaded listener models are never committed (NPL-1.2),
# and the ONNX Runtime web files are copied from node_modules at build time.
*.onnx
apps/app/public/ort/
apps/app/public/recitation-models/

# Local API uploads (dev disk storage when Cloudinary is unset; e2e tests write here too)
apps/api/uploads/

# Local signed Android release bundles (pnpm release:app:* copies, named <device>-<versionCode>-<versionName>.aab)
/*.aab
