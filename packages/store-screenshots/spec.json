    "tracker",
    "qaza",
    "zikr",
    "quran",
    "qibla",
    "names-of-allah",
    "tasbeeh"
  ],
  "slideScenes": {
    "01": "01-home",
    "02": "02-salah",
    "03": "03-qaza",
    "04": "04-library",
    "05": "05-qibla",
    "06": "06-names",
    "07": "07-more"
  },
  "watch": {
    "preferredSize": { "label": "watch-ultra-3", "w": 422, "h": 514 },
    "slideScenes": {
      "01": "01-schedule",
      "02": "02-morning",
      "03": "03-location"
    },
    "note": "Upload Ultra 3 only — App Store Connect scales to smaller watches. Same size across all localizations."
  },
  "tv": {
    "preferredSize": { "label": "tv-1080p", "w": 1920, "h": 1080 },
    "slideScenes": {
      "01": "01-home",
      "02": "02-tracker",
      "03": "03-library",
      "04": "04-quran",
      "05": "05-zikr",
      "06": "06-settings"
    },
    "note": "Apple TV + Android TV / Fire TV screenshots. Default validate-only; RUN_CAPTURE=1 writes PNGs. Fire TV banner/icons are Amazon console uploads (firetv-* under assets/images/tv/), not APK."
  },
  "storeAssetsRoot": "apps/app/store-assets"
}
