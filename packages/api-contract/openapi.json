{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/guest": {
      "post": {
        "operationId": "AuthController_createGuestSession",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Create or resume a guest session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/oauth/{provider}": {
      "post": {
        "operationId": "AuthController_completeOAuth",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                "google",
                "apple",
                "facebook"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Complete OAuth sign-in for Google, Apple, or Facebook",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Rotate the refresh token and issue a new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/link": {
      "post": {
        "operationId": "AuthController_linkAccount",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upgrade a guest account by linking an OAuth provider",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_getCurrentUser",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get the current authenticated user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/sync/pull": {
      "get": {
        "operationId": "SyncController_pull",
        "parameters": [
          {
            "name": "since",
            "required": false,
            "in": "query",
            "description": "ISO timestamp — return changes updated after this moment",
            "schema": {
              "example": "2026-01-01T00:00:00.000Z",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPullResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Pull cloud changes since a timestamp",
        "tags": [
          "sync"
        ]
      }
    },
    "/api/v1/sync/push": {
      "post": {
        "operationId": "SyncController_push",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPushDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPushResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Push local changes using last-write-wins semantics",
        "tags": [
          "sync"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        },
        "summary": "Liveness and readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Munib Tracker API",
    "description": "Cloud sync, authentication, and backend services for Munib Tracker. Track Your Journey Back to Allah.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived signed JWT access token"
          },
          "accessTokenExpiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token; rotates on every refresh"
          },
          "accountType": {
            "type": "string",
            "enum": [
              "guest",
              "user"
            ]
          },
          "userId": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "apple",
              "facebook"
            ]
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "accountType",
          "userId"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "accountType": {
            "type": "string",
            "enum": [
              "guest",
              "user"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "apple",
              "facebook"
            ]
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "accountType"
        ]
      },
      "SyncRecordDto": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "enum": [
              "prayer_logs",
              "zikr_progress",
              "qaza_entries",
              "preferences",
              "favorites"
            ]
          },
          "id": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "updatedAt": {
            "type": "string"
          },
          "deletedAt": {
            "type": "string",
            "description": "Set when the record was deleted on another device"
          }
        },
        "required": [
          "entity",
          "id",
          "data",
          "updatedAt"
        ]
      },
      "SyncPullResponseDto": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecordDto"
            }
          },
          "serverTime": {
            "type": "string"
          }
        },
        "required": [
          "changes",
          "serverTime"
        ]
      },
      "SyncPushDto": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecordDto"
            }
          }
        },
        "required": [
          "changes"
        ]
      },
      "SyncPushResponseDto": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "number"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecordDto"
            }
          },
          "serverTime": {
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "conflicts",
          "serverTime"
        ]
      }
    }
  }
}
