{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/guest": {
      "post": {
        "operationId": "AuthController_createGuestSession",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Create or resume a guest session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/oauth/{provider}": {
      "post": {
        "operationId": "AuthController_completeOAuth",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                "google",
                "apple",
                "facebook"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Complete OAuth sign-in for Google, Apple, or Facebook",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Rotate the refresh token and issue a new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/link": {
      "post": {
        "operationId": "AuthController_linkAccount",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upgrade a guest account by linking an OAuth provider",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_getCurrentUser",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get the current authenticated user",
        "tags": [
          "auth"
        ]
      },
      "delete": {
        "operationId": "AuthController_deleteAccount",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Account, sessions, and all synced data were deleted"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Permanently delete the current account and all its data",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/sync/pull": {
      "get": {
        "operationId": "SyncController_pull",
        "parameters": [
          {
            "name": "since",
            "required": false,
            "in": "query",
            "description": "ISO timestamp — return changes updated after this moment",
            "schema": {
              "example": "2026-01-01T00:00:00.000Z",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPullResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Pull cloud changes since a timestamp",
        "tags": [
          "sync"
        ]
      }
    },
    "/api/v1/sync/push": {
      "post": {
        "operationId": "SyncController_push",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPushDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPushResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Push local changes using last-write-wins semantics",
        "tags": [
          "sync"
        ]
      }
    },
    "/api/v1/content-reports": {
      "post": {
        "operationId": "ContentReportsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON string matching CreateContentReportDto"
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentReportDetailDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Submit a content issue report with optional proof attachments",
        "tags": [
          "content-reports"
        ]
      },
      "get": {
        "operationId": "ContentReportsController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentReportListResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List the current user's content reports",
        "tags": [
          "content-reports"
        ]
      }
    },
    "/api/v1/content-reports/{id}": {
      "get": {
        "operationId": "ContentReportsController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentReportDetailDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a single content report owned by the current user",
        "tags": [
          "content-reports"
        ]
      },
      "patch": {
        "operationId": "ContentReportsController_adminUpdate",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateContentReportDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminContentReportDetailDto"
                }
              }
            }
          }
        },
        "summary": "Admin: update report status and notes (X-Admin-Key required)",
        "tags": [
          "content-reports"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        },
        "summary": "Liveness and readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Munib Tracker API",
    "description": "Cloud sync, authentication, and backend services for Munib Tracker. Track Your Journey Back to Allah.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived signed JWT access token"
          },
          "accessTokenExpiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token; rotates on every refresh"
          },
          "accountType": {
            "type": "string",
            "enum": [
              "guest",
              "user"
            ]
          },
          "userId": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "apple",
              "facebook"
            ]
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "accountType",
          "userId"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "accountType": {
            "type": "string",
            "enum": [
              "guest",
              "user"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "apple",
              "facebook"
            ]
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "accountType"
        ]
      },
      "SyncRecordDto": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "enum": [
              "prayer_logs",
              "zikr_progress",
              "qaza_entries",
              "preferences",
              "favorites",
              "dua_favorites",
              "durood_favorites",
              "name_favorites",
              "quran_bookmarks",
              "quran_last_read",
              "hadith_bookmarks",
              "custom_tasbeeh"
            ]
          },
          "id": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "updatedAt": {
            "type": "string"
          },
          "deletedAt": {
            "type": "string",
            "description": "Set when the record was deleted on another device"
          }
        },
        "required": [
          "entity",
          "id",
          "data",
          "updatedAt"
        ]
      },
      "SyncPullResponseDto": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecordDto"
            }
          },
          "serverTime": {
            "type": "string"
          }
        },
        "required": [
          "changes",
          "serverTime"
        ]
      },
      "SyncPushDto": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecordDto"
            }
          }
        },
        "required": [
          "changes"
        ]
      },
      "SyncPushResponseDto": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "number"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecordDto"
            }
          },
          "serverTime": {
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "conflicts",
          "serverTime"
        ]
      },
      "ContentReportSnapshotDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "arabic": {
            "type": "string"
          },
          "transliteration": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        }
      },
      "ContentReportReferenceDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "quran_ayah",
              "hadith",
              "dua",
              "zikr",
              "durood",
              "name",
              "salah_guide",
              "jannah",
              "battles",
              "learn_quran",
              "learn_dua",
              "taharah",
              "prophets",
              "aqeedah",
              "zakat",
              "seerah",
              "hajj",
              "travel",
              "excused",
              "screen"
            ]
          },
          "contentId": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ContentReportSnapshotDto"
          }
        },
        "required": [
          "kind",
          "contentId",
          "route",
          "locale"
        ]
      },
      "ContentReportDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_review",
              "in_progress",
              "completed",
              "cancelled",
              "spam"
            ]
          },
          "issueType": {
            "type": "string",
            "enum": [
              "incorrect_arabic",
              "incorrect_translation",
              "incorrect_transliteration",
              "wrong_reference",
              "missing_content",
              "audio_issue",
              "typo",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "content": {
            "$ref": "#/components/schemas/ContentReportReferenceDto"
          },
          "attachmentCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "object",
            "nullable": true
          },
          "suggestedCorrection": {
            "type": "object",
            "nullable": true
          },
          "userReference": {
            "type": "object",
            "nullable": true
          },
          "appVersion": {
            "type": "object",
            "nullable": true
          },
          "platform": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "issueType",
          "description",
          "content",
          "attachmentCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "ContentReportSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_review",
              "in_progress",
              "completed",
              "cancelled",
              "spam"
            ]
          },
          "issueType": {
            "type": "string",
            "enum": [
              "incorrect_arabic",
              "incorrect_translation",
              "incorrect_transliteration",
              "wrong_reference",
              "missing_content",
              "audio_issue",
              "typo",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "content": {
            "$ref": "#/components/schemas/ContentReportReferenceDto"
          },
          "attachmentCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "issueType",
          "description",
          "content",
          "attachmentCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "ContentReportListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentReportSummaryDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ]
      },
      "AdminUpdateContentReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_review",
              "in_progress",
              "completed",
              "cancelled",
              "spam"
            ]
          },
          "adminNotes": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "string"
          }
        }
      },
      "AdminContentReportDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_review",
              "in_progress",
              "completed",
              "cancelled",
              "spam"
            ]
          },
          "issueType": {
            "type": "string",
            "enum": [
              "incorrect_arabic",
              "incorrect_translation",
              "incorrect_transliteration",
              "wrong_reference",
              "missing_content",
              "audio_issue",
              "typo",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "content": {
            "$ref": "#/components/schemas/ContentReportReferenceDto"
          },
          "attachmentCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "object",
            "nullable": true
          },
          "suggestedCorrection": {
            "type": "object",
            "nullable": true
          },
          "userReference": {
            "type": "object",
            "nullable": true
          },
          "appVersion": {
            "type": "object",
            "nullable": true
          },
          "platform": {
            "type": "object",
            "nullable": true
          },
          "adminNotes": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "issueType",
          "description",
          "content",
          "attachmentCount",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  }
}
