{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "description": "Compiles and bundles applications for production",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "description": "Starts development servers",
      "cache": false,
      "persistent": true
    },
    "lint": {
      "description": "Runs Biome lint checks",
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "description": "Runs TypeScript type checking",
      "dependsOn": ["^check-types"]
    },
    "test": {
      "description": "Runs unit and feature tests",
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.{test,spec,feature.test}.{ts,tsx}"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "description": "Runs tests in watch mode",
      "cache": false,
      "persistent": true
    },
    "transit": {
      "description": "Invalidates downstream tests when dependencies change",
      "dependsOn": ["^transit"]
    },
    "//#format-and-lint": {
      "description": "Runs Biome format and lint on the entire repo"
    },
    "//#format-and-lint:fix": {
      "description": "Auto-fixes Biome format and lint issues",
      "cache": false
    }
  }
}
