auto-install-peers=true
# Flatten node_modules (no .pnpm symlink store). Required on Windows so that
# native module build paths (e.g. react-native-screens/-worklets CMake/prefab)
# stay under the 260-char MAX_PATH limit. pnpm 9 reads this from .npmrc, not
# from pnpm-workspace.yaml.
node-linker=hoisted
