    "widget.gallery.tasbeeh.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's custom tasbeeh counter progress"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّم عدّاد التسبيح المخصص اليوم"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü xüsusi təsbih sayğacı irəliləyişi"
