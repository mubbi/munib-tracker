    "widget.gallery.events.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown to the next Islamic dates"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العدّ التنازلي للمناسبات الإسلامية القادمة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti islami günlərə geri sayım"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরবর্তী ইসলামি দিবসের কাউন্টডাউন"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbrojavanje do sljedećih islamskih dana"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شمارش معکوس تا مناسبت‌های اسلامی بعدی"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à rebours jusqu'aux prochaines dates islamiques"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙidayar kwanaki zuwa ranakun Musulunci masu zuwa"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले इस्लामी दिनों की उलटी गिनती"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur menuju hari besar Islam berikutnya"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Келесі исламдық күндерге дейін кері санақ"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ژماردنی پێچەوانە بۆ بۆنە ئیسلامییەکانی داهاتوو"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кийинки ислам күндөрүнө чейин тескери эсеп"
          }
        },
        "ms": {
