  "strings": {
    "widget.gallery.nextPrayer.label": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Next Salah" } },
        "ar": { "stringUnit": { "state": "translated", "value": "الصلاة القادمة" } },
        "ur": { "stringUnit": { "state": "translated", "value": "اگلی نماز" } }
      }
    },
