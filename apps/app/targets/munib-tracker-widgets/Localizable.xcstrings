        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresi i planit të hatmes së Kur'anit"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maendeleo ya mpango wa khatm wa Qur'ani"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пешрафти нақшаи хатми Қуръон"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gurhan hatym meýilnamasynyň ösüşi"
          }
        },
        "tr": {
