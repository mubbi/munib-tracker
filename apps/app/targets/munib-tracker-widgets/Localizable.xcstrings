{
  "sourceLanguage": "en",
  "strings": {
    "control.markSalah.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the Salah whose time has begun as prayed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الصلاة التي دخل وقتها كمؤدّاة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس نماز کا وقت شروع ہو چکا ہے اسے ادا شدہ درج کریں۔"
          }
        }
      }
    },
    "control.markSalah.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Salah"
          }
        },
        "ar": {
