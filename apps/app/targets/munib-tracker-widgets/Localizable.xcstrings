        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі арнайы тәсбих есептегішінің үлгерімі"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پێشکەوتنی ژمێرەری تەسبیحی تایبەتی ئەمڕۆ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүнкү ыңгайлаштырылган тасбих эсептегичинин прогресси"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemajuan kaunter tasbeeh tersuai hari ini"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د نن د دودیز تسبیح کاونټر پرمختګ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс пользовательского счётчика тасбиха за сегодня"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Horumarka tiriyaha tasbeeh gaarka ah ee maanta"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresi i numëruesit të personalizuar të tesbihut për sot"
