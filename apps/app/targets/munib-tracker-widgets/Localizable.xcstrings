    "widget.gallery.ramadan.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhoor and iftar times with countdown"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقات السحور والإفطار مع العد التنازلي"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səhər yeməyi və iftar vaxtları gerisayımla"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাহরি ও ইফতারের সময় কাউন্টডাউনসহ"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vremena sehure i iftara s odbrojavanjem"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان سحری و افطار با شمارش معکوس"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horaires de suhoor et d'iftar avec compte à rebours"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokutan sahur da iftar tare da ƙidayar baya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhoor और iftar समय उलटी गिनती के साथ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu sahur dan iftar dengan hitungan mundur"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сәресі мен ауызашар уақыттары кері санақпен"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتی سەحەر و ئیفطار لەگەڵ ژماردنی پاشەکشە"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Оозу ачуу жана ифтар убакыттары тескери эсеп менен"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu sahur dan iftar dengan kiraan undur"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د سحري او افطار وختونه د شمېرنې سره"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время сухура и ифтара с обратным отсчётом"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waqtiyada suhoor iyo iftar oo leh tirinta dib u noqoshada"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraret e syfyrit dhe iftarit me numërim mbrapsht"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyakati za suhoor na iftar na countdown"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақтҳои саҳарӣ ва ифтор бо ҳисоби баръакс"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahur we iftar wagtlary yzyna sanaw bilen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahur ve iftar saatleri, geri sayımla"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سحری و افطار کے اوقات مع الٹی گنتی"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Saharlik va iftorlik vaqtlari teskari hisob bilan"
