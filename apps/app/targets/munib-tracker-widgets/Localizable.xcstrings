      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Next Salah name, time, and countdown." } },
        "ar": { "stringUnit": { "state": "translated", "value": "اسم الصلاة التالية والوقت والعد التنازلي." } },
        "ur": { "stringUnit": { "state": "translated", "value": "اگلی نماز کا نام، وقت اور الٹی گنتی۔" } }
