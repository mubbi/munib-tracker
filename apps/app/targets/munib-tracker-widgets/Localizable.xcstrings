    "widget.gallery.nextPrayer.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Salah name, time, and countdown on home or lock screen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم الصلاة التالية، والوقت، والعد التنازلي على الشاشة الرئيسية أو شاشة القفل"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Evdə və ya kilid ekranında növbəti namaz adı, vaxtı və geri sayım"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোম বা লক স্ক্রিনে পরবর্তী নামাজের নাম, সময় ও কাউন্টডাউন"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime sljedeće molitve, vrijeme i odbrojavanje na početnom ili zaključanom ekranu"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام نماز بعدی، زمان و شمارش معکوس در صفحه اصلی یا صفحه قفل"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom, heure et compte à rebours de la prochaine prière sur l'écran d'accueil ou de verrouillage"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunan addu'a na gaba, lokaci, da ƙidaya akan allon gida ko kullewa"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम या लॉक स्क्रीन पर अगली Salah का नाम, समय और उलटी गिनती"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama doa berikutnya, waktu, dan hitung mundur di layar beranda atau kunci"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үйдегі немесе құлыптау экранындағы келесі намаз аты, уақыты және кері санақ"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناو، کات و پاشماوەی کاتی نوێژی داهاتوو لەسەر شاشەی سەرەکی یان شاشەی قفڵ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Үйдө же кулпу экранында кийинки намаздын аты, убактысы жана артка эсептөө"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama doa, masa dan kira detik seterusnya pada skrin utama atau kunci"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د بل لمانځه نوم، وخت، او په کور یا لاک سکرین کې شمیرنه"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название, время и обратный отсчёт следующего намаза на главном или заблокированном экране"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Magaca salaadada xiga, wakhtiga, iyo tirinta shaashadda guriga ama qufulka"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Emri tjetër i lutjes, koha dhe numërimi mbrapsht në ekranin bazë ose të kyçjes"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jina la maombi linalofuata, saa na siku zijazo kwenye skrini ya nyumbani au iliyofungwa"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Номи навбатии намоз, вақт ва ҳисоб дар экрани хонагӣ ё қулф"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekran veya kilit ekranynda sonraki namaz ady, vakti ve geri sayym"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekran veya kilit ekranında sonraki namaz adı, vakti ve geri sayım"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہوم یا لاک اسکرین پر اگلی نماز کا نام، وقت اور الٹی گنتی"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uy yoki qulflangan ekranda keyingi namoz nomi, vaqti va ortga hisoblash"
          }
        }
      }
    },
