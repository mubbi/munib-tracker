    "widget.gallery.schedule.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's obligatory Salah times at a glance"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقات الصلاة الإلزامية اليوم في لمحة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün vacib namaz vaxtlarına bir baxışda"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের ফরজ নামাজের সময় এক নজরে"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukratko o današnjoj obaveznoj molitvi"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات نماز واجب امروز در یک نگاه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu des heures de prière obligatoires d'aujourd'hui"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokutan sallar farilla na yau a kallo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की फ़र्ज़ नमाज़ों के समय एक नज़र में"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekilas waktu sholat wajib hari ini"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі парыз намаз уақыттары бір қарағанда"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتەکانی نوێژە فەرزەکانی ئەمڕۆ بە یەک سەیرکردن"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүнкү парз намаз убакыттары бир карап"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekilas pandang waktu solat fardhu hari ini"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د نن ورځې د فرض لمانځه وختونه په یو نظر کې"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обязательные времена намаза на сегодня одним взглядом"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiliyada salaada ee maanta la joogo jaleeco"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohët e detyrueshme të namazit të sotëm me një shikim"
          }
        },
