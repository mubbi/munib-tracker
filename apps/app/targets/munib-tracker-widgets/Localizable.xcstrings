    "widget.gallery.friday.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friday checklist progress or days until Jumu'ah"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّم قائمة الجمعة أو الأيام حتى الجمعة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cümə yoxlama siyahısı irəliləyişi və ya Cüməyə qalan günlər"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুক্রবারের চেকলিস্ট অগ্রগতি বা জুমআ পর্যন্ত দিন"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napredak petkove kontrolne liste ili dani do džume"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشرفت چک‌لیست جمعه یا روزهای مانده تا جمعه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression de la liste du vendredi ou jours jusqu'à Jumu'ah"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci gaban jerin Juma'a ko kwanaki har zuwa Juma'a"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुक्रवार चेकलिस्ट प्रगति या Jumu'ah तक दिन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Progres daftar Jumat atau hari hingga Jumat"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұма тізімінің үлгерімі немесе Жұмаға дейінгі күндер"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پێشکەوتنی لیستی هەینی یان ڕۆژ تا هەینی"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жума тизмесинин прогресси же Жумага чейинки күндөр"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemajuan senarai semak Jumaat atau hari hingga Jumaat"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د جمعې چک لیست پرمختګ یا تر جمعې ورځې"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс пятничного чек-листа или дни до джума"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Horumarka liiska Jimcaha ama maalmaha ilaa Jimce"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresi i listës së së premtes ose ditët deri në xhuma"
