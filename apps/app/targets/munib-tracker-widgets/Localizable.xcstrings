          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نوێژ نیشان بکە"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Намазды белгилөө"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai Salah"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "لمونځ نښه کړئ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить намаз"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Calaamadee Salaadda"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shëno namazin"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka alama Salah"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намозро қайд кунед"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Namazy belläň"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namazı işaretle"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز درج کریں"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Namozni belgilash"
          }
        }
      }
    },
    "control.open.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Qibla, Tasbeeh, Qur'an or another screen in one tap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح القبلة أو التسبيح أو القرآن أو شاشة أخرى بلمسة واحدة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ٹیپ میں قبلہ، تسبیح، قرآن یا کوئی اور اسکرین کھولیں۔"
          }
        }
      }
    },
    "control.open.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Munib Tracker"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح في التطبيق"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ میں کھولیں"
          }
        }
      }
    },
    "widget.gallery.adhkar.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The adhkar due now, with your progress"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأذكار المستحقة الآن مع تقدّمك"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırkı zikrlər və irəliləyişiniz"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনকার আযকার ও আপনার অগ্রগতি"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zikr za ovo vrijeme, uz vaš napredak"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اذکارِ این وقت همراه با پیشرفت شما"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adhkar du moment, avec votre progression"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Azkar na wannan lokaci, tare da ci gabanka"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय के अज़कार और आपकी प्रगति"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zikir yang sedang waktunya, dengan progres Anda"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазіргі зікірлер және сіздің барысыңыз"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زیکرەکانی ئێستا لەگەڵ پێشکەوتنەکەت"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азыркы зикирлер жана сиздин жыйынтык"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Zikir yang tiba waktunya, dengan kemajuan anda"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د اوس وخت اذکار او ستاسو پرمختګ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Азкары, которые пора читать, и ваш прогресс"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Adkaarta hadda la gaaray iyo horumarkaaga"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Adhkaret e kësaj kohe, me përparimin tuaj"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Adhkari za wakati huu, pamoja na maendeleo yako"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Азкори ҳозира ва пешрафти шумо"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Häzirki zikirler we siziň ösüşiňiz"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an okunacak zikirler ve ilerlemeniz"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت کے اذکار اور آپ کی پیش رفت"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozirgi zikrlar va sizning natijangiz"
          }
        }
      }
    },
