        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maendeleo ya orodha ya Ijumaa au siku hadi Ijumaa"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пешрафти рӯйхати ҷумъа ё рӯзҳо то ҷумъа"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna sanawynyň ösüşi ýa-da Annaya çenli günler"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma kontrol listesi ilerlemesi veya Cumaya kalan gün"
