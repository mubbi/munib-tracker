    "widget.gallery.dailyHadith.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's hadith from Imam al-Nawawi's Forty"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حديث اليوم من الأربعين النووية"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İmam Nəvəvinin Qırx Hədisindən bugünkü hədis"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমাম নববীর চল্লিশ হাদিস থেকে আজকের হাদিস"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Današnji hadis iz Četrdeset imama en-Nevevija"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حدیث امروز از چهل حدیث امام نووی"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadith du jour parmi les Quarante d'Imam an-Nawawi"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadisin yau daga Arba'in Imam an-Nawawi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Imam al-Nawawi की चालीस में से आज की hadith"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadis hari ini dari Empat Puluh Imam an-Nawawi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Имам Науауидің Қырық хадисінен бүгінгі хадис"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "فەرموودەی ئەمڕۆ لە چل فەرموودەی ئیمام نەوەوی"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Имам Нававийдин Кырк хадисинен бүгүнкү хадис"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadis hari ini daripada Empat Puluh Imam al-Nawawi"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د امام نووي څلوېښت حدیثونو څخه د نن حدیث"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадис дня из Сорока имама ан-Навави"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xadiiska maanta ee Afartan Imam an-Nawawi"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadithi i sotëm nga Dyzetë të Imam en-Neveviut"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadithi ya leo kutoka Arba'in za Imam an-Nawawi"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳадиси имрӯз аз Чиҳил ҳадиси Имом Нававӣ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Imam Nawawynyň Kyrk hadysyndan şu günki hadys"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmam Nevevî'nin Kırk Hadis'inden bugünün hadisi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "امام نووی کی چالیس احادیث میں سے آج کی حدیث"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Imom Navaviyning Qirq hadisidan bugungi hadis"
          }
        }
      }
    },
