<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Preview channel + programs on the Android TV home screen (TvProvider). Install-time;
       implies no hardware, so it never filters devices on Play / the Amazon Appstore. -->
  <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
  <!-- Re-publish the row after a reboot (alarms do not survive one). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Android 11+ package visibility: lets isVoiceSearchAvailable() see the system
       speech recognizer. -->
  <queries>
    <intent>
      <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
    </intent>
  </queries>

  <application>
    <!-- INITIALIZE_PROGRAMS: sent by the TV launcher after install so the default
         channel exists before first launch. BOOT_COMPLETED / REFRESH re-evaluate the
         stored payload (next-Salah windows) while the app is closed. -->
    <receiver
      android:name="expo.modules.munibtvhome.TvHomeReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
