# User-facing semver (CFBundleShortVersionString / versionName)
APP_VERSION=1.0.0

# Android integer version code — increment for every Play Store upload
ANDROID_VERSION_CODE=1

# iOS build number (CFBundleVersion) — increment for every App Store / TestFlight upload
IOS_BUILD_NUMBER=1

# Optional: API base URL for the Expo app (inlined into the client bundle)
# EXPO_PUBLIC_API_URL=http://localhost:3001
