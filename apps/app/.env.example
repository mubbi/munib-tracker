# Marketing semver — owned by Release Please (unified product version). Fallback: app.json expo.version.
# Sync local .env / EAS secrets from these defaults after each app-v* release. See docs/RELEASES.md.
# x-release-please-version markers keep marketing keys aligned; do NOT mark build/versionCode lines.
EXPO_PUBLIC_APP_VERSION=1.1.0 # x-release-please-version

EXPO_ANDROID_APP_VERSION=1.1.0 # x-release-please-version
# Native build integer — bump manually (or EAS autoIncrement) per store upload; not Release Please.
EXPO_ANDROID_VERSION_CODE=1

EXPO_IOS_APP_VERSION=1.1.0 # x-release-please-version
EXPO_IOS_APP_BUILD_NUMBER=1

# Apple TV / Android TV. Play phone+TV share package app.munibtracker —
# keep EXPO_ANDROID_TV_VERSION_CODE unique vs EXPO_ANDROID_VERSION_CODE (never reuse a code).
EXPO_ANDROID_TV_APP_VERSION=1.1.0 # x-release-please-version
EXPO_ANDROID_TV_VERSION_CODE=1

EXPO_TVOS_APP_VERSION=1.1.0 # x-release-please-version
EXPO_TVOS_APP_BUILD_NUMBER=1

# Optional: API base URL for the Expo app (inlined into the client bundle).
# Include the /api/v1 prefix. Defaults to http://localhost:3001/api/v1 when unset.
# Production (Vercel web app): https://api.munibtracker.app/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Sentry (error monitoring) ---
# DSN from Sentry → Project Settings → Client Keys. Inlined into the JS bundle.
# EXPO_PUBLIC_SENTRY_DSN=
# Set to true to send events from local dev builds (default: production/preview only).
# EXPO_PUBLIC_SENTRY_ENABLED_IN_DEV=false
# Org/project slugs for native source-map upload during EAS/prebuild (not shipped in app).
# SENTRY_ORG=
# SENTRY_PROJECT=
# Auth token for source-map upload — set as EAS secret, never commit.
# Local release builds skip upload when this is unset (see release-app-env.cjs).
# SENTRY_AUTH_TOKEN=
# Force skip/enable upload during local Gradle/Xcode release builds (default: skip when no token).
# SENTRY_DISABLE_AUTO_UPLOAD=true

# Optional: marketing site origin for the in-app Privacy / Terms links.
EXPO_PUBLIC_SITE_URL=https://munibtracker.app

# Optional: this web app's own canonical origin (used for SEO canonical URLs,
# sitemap, and structured data). Defaults to https://my.munibtracker.app.
EXPO_PUBLIC_APP_URL=https://my.munibtracker.app

# --- Social sign-in (Google / Apple / Facebook) ---
# Google OAuth client IDs (from Google Cloud Console → Credentials).
# EXPO_PUBLIC_GOOGLE_CLIENT_ID is the shared fallback; the *_WEB / *_IOS / *_ANDROID
# overrides are used per platform when present. Put ALL platform client ids in the
# API's GOOGLE_OAUTH_CLIENT_IDS (comma-separated) so native access tokens validate.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# iOS bundle ID (native Apple JWT `aud`). Defaults to app.munibtracker when unset.
EXPO_PUBLIC_APP_IDENTIFIER=app.munibtracker

# Product web origin for OAuth redirects / Apple App Links (falls back to EXPO_PUBLIC_APP_URL).
EXPO_PUBLIC_WEB_APP_ORIGIN=https://my.munibtracker.app

# Apple Services ID for web/Android "Sign in with Apple" (matches APPLE_SERVICES_ID
# on the API). Not needed for native iOS Sign in with Apple.
EXPO_PUBLIC_APPLE_SERVICES_ID=
# Apple Team ID for iOS code signing (also accepted: IOS_DEVELOPMENT_TEAM).
# EXPO_APPLE_TEAM_ID=

# Facebook App ID (matches FACEBOOK_APP_ID on the API; secret stays server-side).
EXPO_PUBLIC_FACEBOOK_APP_ID=

# iOS signing keys live in apps/app/ios-keys/ (gitignored *.p8 files):
#   munib_build_api_AuthKey_<KEY_ID>.p8  — EAS / App Store Connect API + TestFlight upload
#   munib_signin_AuthKey_<KEY_ID>.p8     — Sign in with Apple (API OAuth)
#   munib_apn_AuthKey_<KEY_ID>.p8        — APNs push key
# Upload setup: pnpm ios:setup-app-store-connect
# IPA: pnpm release:app:ios   Upload: pnpm release:app:ios:upload

# --- PWA / Web Push (optional) ---
# VAPID public key for browser push notifications on the installed web app.
# Generate a key pair and set the matching private key on the API for push delivery.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
