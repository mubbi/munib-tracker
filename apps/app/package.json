{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:android": "node scripts/ensure-build-env.js && eas build --platform android --profile production",
    "build:ios": "node scripts/ensure-build-env.js && eas build --platform ios --profile production",
    "build:android:preview": "node scripts/ensure-build-env.js && eas build --platform android --profile preview",
    "build:ios:preview": "node scripts/ensure-build-env.js && eas build --platform ios --profile preview",
    "build:android:local": "node scripts/ensure-build-env.js && eas build --platform android --profile production --local",
    "build:ios:local": "node scripts/ensure-build-env.js && eas build --platform ios --profile production --local",
    "version:print": "node scripts/ensure-build-env.js",
    "build:data": "node scripts/build-data/index.mjs && biome check --write ../../packages/shared/src/content src/lib/quran-loader.ts",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "sync:pwa-manifest": "node scripts/sync-pwa-manifest.mjs",
    "build:web": "node scripts/sync-pwa-manifest.mjs && node scripts/metro-node-heap.cjs export --platform web",
    "transit": "echo transit"
  },
  "dependencies": {
    "@munib-tracker/api-client": "workspace:*",
    "@munib-tracker/shared": "workspace:*",
    "@munib-tracker/theme": "workspace:*",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tanstack/react-query": "^5.90.2",
    "adhan": "^4.4.3",
    "babel-preset-expo": "~57.0.0",
    "bowser": "^2.14.1",
    "expo": "~57.0.1",
    "expo-audio": "~57.0.0",
    "expo-auth-session": "~57.0.1",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.1",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.0",
    "expo-location": "~57.0.1",
    "expo-notifications": "~57.0.2",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.0",
    "expo-sensors": "~57.0.1",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "fuse.js": "^7.4.2",
    "i18next": "^24.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.4.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "reanimated-color-picker": "^5.1.1"
  },
  "devDependencies": {
    "@munib-tracker/typescript-config": "workspace:*",
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eas-cli": "^16.28.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  }
}
