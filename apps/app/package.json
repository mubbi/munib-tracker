{
  "name": "app",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-file-system",
          "expo-image-picker"
        ]
      }
    }
  },
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "android": "node scripts/run-android.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:web:clear": "expo start --web --clear",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "node scripts/prebuild-clean.js",
    "prebuild:android": "node scripts/prebuild-android.js",
    "prebuild:ios": "node scripts/prebuild-ios.js",
    "prebuild:tv": "node scripts/prebuild-tv.js --clean",
    "prebuild:tv:android": "node scripts/prebuild-tv.js --clean --platform android",
    "prebuild:tv:ios": "node scripts/prebuild-tv.js --clean --platform ios",
    "prebuild:clean:android": "node scripts/prebuild-android.js --clean",
    "prebuild:clean:ios": "node scripts/prebuild-ios.js --clean",
    "cleanbuild:android": "node scripts/prebuild-android.js --clean",
    "cleanbuild:ios": "node scripts/prebuild-ios.js --clean",
    "cleanbuild:tv": "node scripts/prebuild-tv.js --clean",
    "cleanbuild:tv:android": "node scripts/prebuild-tv.js --clean --platform android",
    "cleanbuild:tv:ios": "node scripts/prebuild-tv.js --clean --platform ios",
    "tv:android": "node scripts/run-android.js --tv",
    "tv:ios": "node scripts/with-expo-tv.js expo run:ios",
    "tv:remote": "node scripts/tv-remote.js",
    "rebuild:android": "node scripts/prebuild-android.js --clean && node scripts/run-android.js --clear-metro",
    "rebuild:ios": "node scripts/prebuild-ios.js --clean && expo run:ios",
    "rebuild:tv:android": "node scripts/prebuild-tv.js --clean --platform android && node scripts/run-android.js --tv --clear-metro",
    "rebuild:tv:ios": "node scripts/prebuild-tv.js --clean --platform ios && node scripts/with-expo-tv.js expo run:ios",
    "doctor": "pnpm exec expo doctor",
    "emulator": "node scripts/android-emulator.js",
    "emulator:cold": "node scripts/android-emulator.js --cold",
    "emulator:wipe": "node scripts/android-emulator.js --wipe",
    "emulator:doctor": "node scripts/android-emulator.js --doctor",
    "android:signing-report": "node scripts/android-signing-report.js",
    "android:bundle:release": "node scripts/android-release.js",
    "android:apk:release": "node scripts/android-release.js --apk",
    "android:bundle:release:tv": "node scripts/android-release.js --tv",
    "android:apk:release:tv": "node scripts/android-release.js --tv --apk",
    "android:verify-upload-aab": "node scripts/verify-android-upload-aab.js",
    "android:upload:release": "node scripts/android-upload.js",
    "android:upload:release:tv": "node scripts/android-upload.js --tv",
    "ios:signing-report": "node scripts/ios-signing-report.js",
    "ios:archive:release": "node scripts/ios-release.js",
    "ios:archive:release:tv": "node scripts/ios-tv-release.js",
    "ios:upload:release": "node scripts/ios-upload.js",
    "ios:upload:release:validate": "node scripts/ios-upload.js --validate-only",
    "ios:upload:release:tv": "node scripts/ios-tv-upload.js",
    "ios:upload:release:tv:validate": "node scripts/ios-tv-upload.js --validate-only",
    "ios:setup-app-store-connect": "node scripts/setup-ios-app-store-connect.js",
    "ios:pod-install": "cd ios && pod install",
    "build:android": "node scripts/ensure-build-env.js && eas build --platform android --profile production",
    "build:ios": "node scripts/ensure-build-env.js --ios-eas && eas build --platform ios --profile production",
    "build:android:tv": "node scripts/ensure-build-env.js --tv && eas build --platform android --profile production_tv",
    "build:ios:tv": "node scripts/ensure-build-env.js --tv --ios-eas && eas build --platform ios --profile production_tv",
    "build:android:preview": "node scripts/ensure-build-env.js && eas build --platform android --profile preview",
    "build:ios:preview": "node scripts/ensure-build-env.js --ios-eas && eas build --platform ios --profile preview",
    "build:android:preview:tv": "node scripts/ensure-build-env.js --tv && eas build --platform android --profile preview_tv",
    "build:ios:preview:tv": "node scripts/ensure-build-env.js --tv --ios-eas && eas build --platform ios --profile preview_tv",
    "build:android:local": "node scripts/ensure-build-env.js && eas build --platform android --profile production --local",
    "build:ios:local": "node scripts/ensure-build-env.js --ios-eas && eas build --platform ios --profile production --local",
    "build:android:local:tv": "node scripts/ensure-build-env.js --tv && eas build --platform android --profile production_tv --local",
    "build:ios:local:tv": "node scripts/ensure-build-env.js --tv --ios-eas && eas build --platform ios --profile production_tv --local",
    "submit:android:tv": "eas submit --platform android --profile production_tv --latest",
    "submit:ios:tv": "eas submit --platform ios --profile production_tv --latest",
    "version:print": "node scripts/ensure-build-env.js",
    "build:data": "node scripts/build-data/index.mjs && biome check --write ../../packages/shared/src/content src/lib/quran-loader.ts",
    "check-types": "node scripts/ensure-expo-env.mjs && tsc --noEmit",
    "lint": "biome check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watchAll",
    "generate:brand-assets": "python scripts/generate-brand-assets.py",
    "refresh:brand-assets": "python scripts/generate-brand-assets.py && node scripts/sync-pwa-manifest.mjs",
    "sync:pwa-manifest": "node scripts/sync-pwa-manifest.mjs",
    "clear:web-cache": "node -e \"require('node:fs').rmSync('.expo/web/cache',{recursive:true,force:true})\"",
    "clear:metro-cache": "node -e \"console.log('Cleared', require('./scripts/lib/native-script-utils.cjs').clearMetroDiskCache(), 'Metro cache entries')\"",
    "build:web": "node scripts/sync-pwa-manifest.mjs && node scripts/generate-well-known.mjs && node scripts/metro-node-heap.cjs export --platform web && node scripts/inject-seo-head.mjs && node scripts/generate-seo-files.mjs",
    "screenshots:validate": "node scripts/screenshots/validate.mjs",
    "screenshots:android": "node scripts/screenshots/capture-android.mjs",
    "screenshots:ios": "node scripts/screenshots/capture-ios.mjs",
    "transit": "echo transit"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/ui": "^57.0.3",
    "@munib-tracker/api-client": "workspace:*",
    "@munib-tracker/shared": "workspace:*",
    "@munib-tracker/theme": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^8.18.0",
    "@tanstack/react-query": "^5.90.2",
    "adhan": "^4.4.3",
    "astronomy-engine": "^2.1.19",
    "babel-preset-expo": "~57.0.0",
    "bowser": "^2.14.1",
    "expo": "~57.0.2",
    "expo-apple-authentication": "~57.0.0",
    "expo-audio": "~57.0.0",
    "expo-auth-session": "~57.0.1",
    "expo-blur": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.1",
    "expo-local-authentication": "^57.0.0",
    "expo-localization": "~57.0.0",
    "expo-location": "~57.0.2",
    "expo-navigation-bar": "~57.0.1",
    "expo-network": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-sensors": "~57.0.1",
    "expo-sharing": "^57.0.2",
    "expo-speech": "~57.0.0",
    "expo-speech-recognition": "~56.0.1",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "^57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-task-manager": "~57.0.5",
    "expo-web-browser": "~57.0.0",
    "fuse.js": "^7.4.2",
    "i18next": "^24.2.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.4.0",
    "react-native": "npm:react-native-tvos@0.86.0-2",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "^8.0.3",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-quick-crypto": "^1.1.5",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "^5.1.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "reanimated-color-picker": "^5.1.1"
  },
  "devDependencies": {
    "@munib-tracker/typescript-config": "workspace:*",
    "@react-native-tvos/config-tv": "^0.1.5",
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "eas-cli": "^16.28.0",
    "expo-dev-client": "~57.0.5",
    "googleapis": "^173.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  }
}
