# App Store Connect upload credentials (altool). Copy to app-store-connect.env (gitignored).
# Never commit app-store-connect.env or *.p8 files.
#
# API key: App Store Connect → Users and Access → Integrations →
# App Store Connect API → + → download once.
#
# Save the key as ios-keys/munib_build_api_AuthKey_<KEY_ID>.p8 (Key ID is read from the filename).
APP_STORE_CONNECT_API_ISSUER_ID=3fd01e97-6d5a-4982-96d7-c151c21e391b
# Optional overrides:
# APP_STORE_CONNECT_API_KEY_ID=U7JUX5D2Q7
# APP_STORE_CONNECT_API_KEY_PATH=ios-keys/munib_build_api_AuthKey_U7JUX5D2Q7.p8
#
# Apple ID + app-specific password (alternative):
# APP_STORE_CONNECT_APPLE_ID=
# APP_STORE_CONNECT_APP_PASSWORD=
# APP_STORE_CONNECT_APP_PASSWORD=@keychain:AC_UPLOAD_PASSWORD
