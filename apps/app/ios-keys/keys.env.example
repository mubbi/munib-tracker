# App Store Connect API — pairs with munib_build_api_AuthKey_<KEY_ID>.p8
# Users and Access → Keys → Issuer ID
EXPO_ASC_API_KEY_ISSUER_ID=

# Optional explicit filenames (override prefix auto-discovery)
# IOS_BUILD_API_KEY=munib_build_api_AuthKey_U7JUX5D2Q7.p8
# IOS_SIGNIN_AUTH_KEY=munib_signin_AuthKey_872P5HZFP6.p8
# IOS_APN_AUTH_KEY=munib_apn_AuthKey_9WGVFXS2RY.p8

# Optional team ID when not set in apps/app/.env (EXPO_APPLE_TEAM_ID / IOS_DEVELOPMENT_TEAM)
# IOS_DEVELOPMENT_TEAM=
