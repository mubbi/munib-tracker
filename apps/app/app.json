{
  "expo": {
    "name": "Munib Tracker",
    "slug": "munib-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "munib-tracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.munibtracker",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "associatedDomains": ["applinks:my.munibtracker.app"],
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "audio"],
        "NSSupportsLiveActivities": true,
        "NSCameraUsageDescription": "Munib Tracker uses the camera so you can attach photos to custom adhkar.",
        "NSPhotoLibraryUsageDescription": "Munib Tracker uses your photo library so you can attach images to custom adhkar."
      }
    },
    "android": {
      "package": "app.munibtracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#152921",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "my.munibtracker.app",
              "pathPrefix": "/oauth/apple"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Munib Tracker",
      "shortName": "Munib Tracker",
      "description": "Track Your Journey Back to Allah. A free, offline-first companion for salah, dhikr, qadha, Qur'an, hadith, and daily worship.",
      "themeColor": "#152921",
      "backgroundColor": "#152921"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "android": false,
            "ios": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#152921",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "android": {
            "imageWidth": 220
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Munib Tracker uses your photo library so you can attach images to custom adhkar.",
          "cameraPermission": "Munib Tracker uses the camera so you can attach photos to custom adhkar."
        }
      ],
      "expo-document-picker",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Munib Tracker uses your location to calculate accurate prayer times and the qibla direction for where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#059669",
          "sounds": ["./assets/audio/adhan/adhan.mp3"],
          "mode": "production"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/with-android-build-hygiene.js",
      "./plugins/withAndroidReleaseSigning.cjs",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
