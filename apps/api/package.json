{
  "name": "api",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome check .",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && vitest run --config vitest.config.e2e.mts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "openapi": "cross-env DATABASE_TYPE=sqlite NODE_ENV=test EXPORT_OPENAPI=true node dist/main.js",
    "typeorm": "cross-env NODE_OPTIONS=--import=tsx typeorm -d src/database/data-source.ts",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:generate": "cross-env NODE_OPTIONS=--import=tsx typeorm migration:generate -d src/database/data-source.ts",
    "transit": "echo transit"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@munib-tracker/live-activity-delivery": "workspace:*",
    "@munib-tracker/shared": "workspace:*",
    "@munib-tracker/surface-push-delivery": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "@upstash/qstash": "^2.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@munib-tracker/typescript-config": "workspace:*",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@rspack/core": "^2.3.3",
    "@swc/core": "^1.16.22",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webpack-node-externals": "^3.0.0"
  }
}
