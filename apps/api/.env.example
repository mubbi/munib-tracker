# API server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=munib_tracker
DATABASE_SSL=false
# When DATABASE_SSL=true the server verifies the DB's TLS certificate by default.
# Only set this to false for a managed provider with a self-signed cert, and
# prefer pinning that provider's CA via DATABASE_CA_CERT instead of disabling it.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA bundle; one line with literal \n between PEM lines.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIIF...\n-----END CERTIFICATE-----
# In production set NODE_ENV=production (disables synchronize) and apply schema
# with: pnpm --filter api migration:run

# Comma-separated origins allowed for CORS (Expo dev, marketing site, etc.)
# Production (Vercel): https://munibtracker.app,https://my.munibtracker.app
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://munibtracker.app,https://my.munibtracker.app

# Auth — replace before production
JWT_SECRET=change-me-in-production
# Access-token lifetime (jsonwebtoken duration string) and refresh-token days
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OAuth providers (leave blank to disable a given provider's sign-in)

# Google — comma/space-separated client IDs for access-token / id_token audience checks
# (Web + iOS + Android). Native Sign-In posts an access token; web uses code exchange.
# GOOGLE_OAUTH_WEB_CLIENT_ID (optional) is used for the authorization-code exchange; defaults
# to the first GOOGLE_OAUTH_CLIENT_IDS entry. Must match EXPO_PUBLIC_GOOGLE_CLIENT_ID(_WEB).
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=

# Redirect URIs allowed for OAuth code exchange (web + native scheme + Apple callback).
# Required in production. Include product web origin, App Link return URLs, Google reversed
# schemes, and the API Apple form_post callback.
# OAUTH_REDIRECT_URI_ALLOWLIST=https://my.munibtracker.app,https://my.munibtracker.app/oauth/apple,https://api.munibtracker.app/api/v1/auth/apple/oauth/callback,com.googleusercontent.apps.YOUR_ANDROID_CLIENT:/oauthredirect,com.googleusercontent.apps.YOUR_IOS_CLIENT:/oauthredirect

# Apple
# APPLE_CLIENT_IDS: comma/space-separated list of allowed id_token audiences.
#   Include the iOS bundle id (native Sign in with Apple) and, when using the
#   web/Android Apple OAuth flow, the Services ID. e.g. app.munibtracker,com.munibtracker.web
APPLE_CLIENT_IDS=
# Legacy single audience (if APPLE_CLIENT_IDS is unset):
# APPLE_CLIENT_ID=
# APPLE_SERVICES_ID: the Services ID used as the client_id for web/Android Apple
#   OAuth (differs from the bundle id). Falls back to the first APPLE_CLIENT_IDS when unset.
APPLE_SERVICES_ID=
# The following are required only for web/Android Apple OAuth (native iOS does not need them).
# From your Apple Developer account (Keys → Sign in with Apple key .p8):
APPLE_TEAM_ID=
APPLE_KEY_ID=
# One line; use literal \n between PEM lines:
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----
APPLE_PRIVATE_KEY=

# Facebook Login (leave blank to disable)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Content reports — attachment storage and admin triage
# Local/dev: disk directory. On Vercel set CLOUDINARY_* instead (ephemeral FS).
REPORT_ATTACHMENTS_DIR=./uploads/reports
# Cloudinary (https://cloudinary.com/console) — cloud name + API key/secret:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional folder prefix (default: munib-tracker/reports)
# CLOUDINARY_FOLDER=munib-tracker/reports
# Set to a strong secret to enable PATCH /content-reports/:id admin triage
REPORT_ADMIN_KEY=

# Durable rate limits across serverless instances (Upstash Redis REST).
# When unset, falls back to in-memory limits (fine for local single-process).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
