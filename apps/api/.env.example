# API server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=munib_tracker
DATABASE_SSL=false

# Comma-separated origins allowed for CORS (Expo dev, marketing site, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Auth — replace before production
JWT_SECRET=change-me-in-production

# OAuth providers (optional until social login is wired)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
