# Admin console — server-only secrets (never EXPO_PUBLIC_* / NEXT_PUBLIC_* for DB).
# Copy to apps/admin/.env.local for local dev.
# Guides: docs/ADMIN.md · docs/ADMIN_BROADCASTS.md · docs/PRODUCTION.md

# Same Postgres as apps/api — must be named DATABASE_URL (not POSTGRES_URL /
# POSTGRES_PRISMA_URL). On Vercel, copy the value verbatim from the API project.
# Supabase: Session pooler (port 5432). Do not append ?supa=… dashboard junk.
# Example:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Do not use the publishable anon key — this URI must be the DB password (server-only).
DATABASE_URL=postgresql://postgres:@localhost:5432/munib_tracker

# Public origin for OAuth redirect (local). Production: https://admin.munibtracker.app
ADMIN_URL=http://localhost:3002

# Local next dev only: skip Google login and act as super_admin.
# Ignored when NODE_ENV≠development or VERCEL is set (preview/prod stay gated).
ADMIN_DEV_BYPASS_AUTH=1

# 32+ char random secret — openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Google OAuth web client — redirect URI = ${ADMIN_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nest API origin for health checks (includes Redis snapshot when REDIS_URL is set on the API)
API_URL=http://localhost:3001

# Web Push (same VAPID pair as apps/api VAPID_PUBLIC_KEY). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@munibtracker.app

# Bearer for cron-job.org → GET|POST /api/cron/process-broadcasts (every 15 min)
# ADMIN_CRON_SECRET=

# Optional Redis (same instance as apps/api) — leader lock so overlapping cron hits
# do not double-process broadcasts. When unset, every invocation may run (fail-open).
# Local / Redis Cloud TLS off: redis://…
# Redis Cloud TLS on:          rediss://…
# Optional: REDIS_TLS=true|false to override the scheme
# REDIS_URL=
# REDIS_TLS=
# REDIS_KEY_PREFIX=development
