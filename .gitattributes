# Husky hooks must use LF — CRLF breaks `sh -e` under Git for Windows.
.husky/** text eol=lf

# Keep package manifests LF so Release Please bumps do not fail Biome on Windows/CI.
**/package.json text eol=lf
**/.release-please-manifest.json text eol=lf

# Biome treats CRLF as a format error; keep source LF on all platforms.
*.cjs text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf

# Byte-compared by drift / hash tests (generator output, fixture hashes) — a CRLF
# checkout on Windows would fail them.
*.swift text eol=lf
*.kt text eol=lf
*.xcstrings text eol=lf
apps/app/src/lib/quran-morphology/__fixtures__/*.txt text eol=lf
